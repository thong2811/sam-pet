<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */

use Application\Model\Expenses;
?>
<div class="row mt-5">
    <h1> Nhập chi </h1>
    <form id="expensesAddForm">
        <div class="container">
            <table class="table table-striped table-form mt-3">
                <thead>
                <tr>
                    <th style="width: 150px">Ngày</th>
                    <th style="width: 150px">Loại chi</th>
                    <th>Lý do chi</th>
                    <th style="width: 150px">Số tiền</th>
                    <th style="width: 150px">Người chi</th>
                    <th style="width: 300px">Ghi chú</th>
                    <th style="width: 60px">Xóa</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>
                        <input class="form-control date-picker w-100" name="date[]"
                               value="<?= date('d-m-Y') ?>" autocomplete="off" required/>
                    </td>
                    <td>
                        <select class="form-control" name="type[]">
                            <option value="<?= Expenses::TYPE_OTHER ?>">Khác</option>
                            <option value="<?= Expenses::TYPE_SAVINGS ?>">Tiền tiết kiệm</option>
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control reason" name="reason[]"
                               required onchange="addInputRow(this)">
                    </td>
                    <td>
                        <div class="input-group">
                            <span class="input-group-text">VNĐ</span>
                            <input type="text" class="form-control" name="amount[]" required>
                        </div>
                    </td>
                    <td>
                        <input type="text" class="form-control" name="person[]">
                    </td>
                    <td>
                        <textarea class="form-control" name="note[]" rows="1"></textarea>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeInputRow(this)">✕</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="mb-3">
            <button type="button" class="btn btn-primary float-end" onclick="doSubmit()">Tạo</button>
            <a href="/expenses" class="btn btn-secondary float-end mx-2">Quay lại</a>
        </div>
    </form>
</div>

<script>
    let tableInputRowHtml = '';

    $(document).ready(function () {
        tableInputRowHtml = $('.table-form tbody').html();
        $('.date-picker').datepicker({ format: 'dd-mm-yyyy', autoclose: true });
    });

    $(document).keypress(e => { if (e.which === 13) e.preventDefault(); });

    function addInputRow(elm) {
        const value    = $(elm).val();
        const tbodyElm = $(elm).closest('tbody');
        const datePicked = $(elm).closest('tr').find('.date-picker').val();

        if (value && $('.reason').last().val() !== '') {
            tbodyElm.append(tableInputRowHtml);
            const dp = tbodyElm.find('.date-picker').last();
            dp.datepicker({ format: 'dd-mm-yyyy', autoclose: true });
            dp.val(datePicked);
        }
    }

    function removeInputRow(btn) {
        const tbody = $(btn).closest('tbody');
        if (tbody.find('tr').length <= 1) return;
        $(btn).closest('tr').remove();
    }

    function doSubmit() {
        const form = document.getElementById('expensesAddForm');
        if (!form.checkValidity()) { form.classList.add('was-validated'); return; }

        showOverlay('loading');

        $.ajax({
            url: '/expenses/do-add',
            type: 'POST',
            data: $('#expensesAddForm').serialize(),
            success: function (res) {
                if (res.success) {
                    addFlashMessage(res.message || 'Thêm thành công!');
                    window.location.href = '/expenses';
                } else {
                    addFlashMessage(res.message || 'Có lỗi xảy ra.', FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, err) {
                addFlashMessage('Lỗi kết nối: ' + err, FLASH_MESSAGE_TYPE_ERROR);
            },
            complete: hideOverlay
        });
    }
</script>
