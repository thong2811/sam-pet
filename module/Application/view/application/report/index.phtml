<!-- Modal Sửa — dùng prefix "edit-" cho tất cả id input để tránh duplicate -->
<div id="editReportModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật báo cáo ngày</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editReportForm" method="post">
                    <input type="hidden" id="edit-reportId" name="id">
                    <div class="mb-3">
                        <label class="form-label">Ngày</label>
                        <input type="text" class="form-control date-picker" id="edit-date" name="date"
                               autocomplete="off" onchange="reloadReportByDate('edit')" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tiền dư/thiếu</label>
                        <div class="input-group">
                            <span class="input-group-text">VNĐ</span>
                            <input type="text" class="form-control" id="edit-missingAmount" name="missingAmount">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea id="edit-note" class="form-control" name="note"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tính tiền
                            <small class="text-muted fw-normal">(Tự động tải khi thay đổi ngày)</small>
                        </label>
                        <div id="edit-loadingMsg" class="text-secondary d-none mb-1">
                            <span class="spinner-border spinner-border-sm"></span> Đang tải...
                        </div>
                        <div class="card p-3 bg-light">
                            <?= $this->partial('application/report/_finance-fields.phtml', ['prefix' => 'edit', 'treatmentProfitPercent' => $treatmentProfitPercent]) ?>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="doEdit()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm — dùng prefix "add-" -->
<div id="addReportModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm báo cáo ngày</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addReportForm" method="post">
                    <div class="mb-3">
                        <label class="form-label">Ngày</label>
                        <input type="text" class="form-control date-picker" id="add-date" name="date"
                               autocomplete="off" onchange="reloadReportByDate('add')" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tiền dư/thiếu</label>
                        <div class="input-group">
                            <span class="input-group-text">VNĐ</span>
                            <input type="text" class="form-control" id="add-missingAmount" name="missingAmount">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea id="add-note" class="form-control" name="note"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tính tiền
                            <small class="text-muted fw-normal">(Tự động tải khi thay đổi ngày)</small>
                        </label>
                        <div id="add-loadingMsg" class="text-secondary d-none mb-1">
                            <span class="spinner-border spinner-border-sm"></span> Đang tải...
                        </div>
                        <div class="card p-3 bg-light">
                            <?= $this->partial('application/report/_finance-fields.phtml', ['prefix' => 'add', 'treatmentProfitPercent' => $treatmentProfitPercent]) ?>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="doAdd()">Thêm</button>
            </div>
        </div>
    </div>
</div>

<script>
    const controllerName = 'report';
    const TREATMENT_PROFIT_PERCENT = <?= $treatmentProfitPercent ?>;

    const table = initDataTable('#dataTable', {
        ...DATA_TABLES_CONFIG,
        ajax: {
            url: `/${controllerName}/data-table-server-side`,
            type: 'POST',
            dataSrc: (json) => {
                reloadHeaderInfo(json);
                return json.data || {};
            }
        },
        columns: [
            { name: 'no',               data: 'no' },
            { name: 'date',             data: 'date' },
            { name: 'petShopRevenue',   data: 'petShopRevenue',   render: $.fn.dataTable.render.number(',') },
            { name: 'petShopProfit',    data: 'petShopProfit',    render: $.fn.dataTable.render.number(',') },
            { name: 'spaRevenue',       data: 'spaRevenue',       render: $.fn.dataTable.render.number(',') },
            { name: 'treatmentRevenue', data: 'treatmentRevenue', render: $.fn.dataTable.render.number(',') },
            { name: 'treatmentProfit',  data: 'treatmentProfit',  render: $.fn.dataTable.render.number(',') },
            { name: 'revenue',          data: 'revenue',          render: $.fn.dataTable.render.number(',') },
            { name: 'expenses',         data: 'expenses',         render: $.fn.dataTable.render.number(',') },
            { name: 'savings',          data: 'savings',          render: $.fn.dataTable.render.number(',') },
            { name: 'remaining',        data: 'remaining',        render: $.fn.dataTable.render.number(',') },
            { name: 'missingAmount',    data: 'missingAmount',    render: $.fn.dataTable.render.number(',') },
            { name: 'note',             data: 'note' },
            {
                name: 'action', data: 'id',
                render: (id) =>
                    `<button class="btn btn-danger btn-sm" onclick="removeRow('report','${id}',table)">Xóa</button>` +
                    `<button class="btn btn-primary btn-sm ms-1" onclick="openEditModal('${id}')">Cập nhật</button>`
            }
        ],
        serverSide: true
    });

    function reloadHeaderInfo(json) {
        const totalRevenue      = json.totalRevenue      || 0;
        const totalExpenses     = json.totalExpenses     || 0;
        const totalMissingAmount= json.totalMissingAmount|| 0;
        const totalProfit       = totalRevenue - totalExpenses + totalMissingAmount;

        $('#totalRevenue').html(formatNumber(totalRevenue)       + ' VNĐ');
        $('#totalExpenses').html(formatNumber(totalExpenses)     + ' VNĐ');
        $('#totalMissingAmount').html(formatNumber(totalMissingAmount) + ' VNĐ');
        $('#totalProfit').html(formatNumber(totalProfit)         + ' VNĐ');
    }

    const editModal = initModal('#editReportModal');
    const addModal  = initModal('#addReportModal');

    function openEditModal(id) {
        clearModalForm('#editReportModal');
        const data = table.data().toArray().find(r => r.id === id) || {};
        $('#edit-reportId').val(data.id       || '');
        $('#edit-date').val(data.date          || '');
        $('#edit-missingAmount').val(data.missingAmount || '');
        $('#edit-note').val(data.note          || '');
        // Tải lại số liệu theo ngày qua AJAX
        if (data.date) reloadReportByDate('edit', data.date);
        editModal.show();
    }

    function openAddModal() {
        clearModalForm('#addReportModal');
        addModal.show();
    }

    function doAdd() {
        if (!validateModalForm('#addReportModal')) return;
        if ($('#add-petShopRevenue').val() === '') { alert('Lỗi: Doanh thu pet shop đang rỗng!'); return; }

        const form = $('#addReportForm');
        const csrfInput = document.createElement('input');
        csrfInput.type  = 'hidden';
        csrfInput.name  = '_csrf';
        csrfInput.value = getCsrfToken();
        form.append(csrfInput);

        $.ajax({
            url: `/${controllerName}/do-add`,
            type: 'POST',
            data: form.serialize(),
            beforeSend: () => $('.overlay-loading').css('display','flex'),
            success: (res) => {
                if (res.success) { table.draw(false); addModal.hide(); addFlashMessage('Thêm thành công'); }
                else addFlashMessage('Lỗi khi thêm: ' + (res.message||'unknown'), FLASH_MESSAGE_TYPE_ERROR);
            },
            error: (x,s,e) => addFlashMessage('Lỗi kết nối: ' + e, FLASH_MESSAGE_TYPE_ERROR),
            complete: () => $('.overlay-loading').hide()
        });
    }

    function doEdit() {
        if (!validateModalForm('#editReportModal')) return;
        if ($('#edit-petShopRevenue').val() === '') { alert('Lỗi: Doanh thu pet shop đang rỗng!'); return; }

        const form = $('#editReportForm');
        const csrfInput = document.createElement('input');
        csrfInput.type  = 'hidden';
        csrfInput.name  = '_csrf';
        csrfInput.value = getCsrfToken();
        form.append(csrfInput);

        $.ajax({
            url: `/${controllerName}/do-edit`,
            type: 'POST',
            data: form.serialize(),
            beforeSend: () => $('.overlay-loading').css('display','flex'),
            success: (res) => {
                if (res.success) { table.draw(false); editModal.hide(); addFlashMessage('Cập nhật thành công'); }
                else addFlashMessage('Lỗi khi cập nhật: ' + (res.message||'unknown'), FLASH_MESSAGE_TYPE_ERROR);
            },
            error: (x,s,e) => addFlashMessage('Lỗi kết nối: ' + e, FLASH_MESSAGE_TYPE_ERROR),
            complete: () => $('.overlay-loading').hide()
        });
    }

    /**
     * Tải dữ liệu tài chính theo ngày qua AJAX endpoint /report/data-by-date
     * @param {string} prefix   - 'edit' hoặc 'add'
     * @param {string|null} date - override ngày (khi mở modal edit)
     */
    function reloadReportByDate(prefix, date = null) {
        if (!date) date = $(`#${prefix}-date`).val();
        if (!date) return;

        $(`#${prefix}-loadingMsg`).removeClass('d-none');
        resetFinanceFields(prefix);

        $.get('/report/data-by-date', { date: date })
            .done(function (res) {
                if (!res.success) {
                    addFlashMessage(res.message || 'Không tải được dữ liệu ngày ' + date, FLASH_MESSAGE_TYPE_ERROR);
                    return;
                }
                const d       = res.data;
                const revenue = (d.petShopRevenue||0) + (d.spaRevenue||0) + (d.treatmentRevenue||0);
                $(`#${prefix}-petShopRevenue`).val(d.petShopRevenue   || 0);
                $(`#${prefix}-petShopProfit`).val(d.petShopProfit     || 0);
                $(`#${prefix}-spaRevenue`).val(d.spaRevenue           || 0);
                $(`#${prefix}-treatmentRevenue`).val(d.treatmentRevenue|| 0);
                $(`#${prefix}-treatmentProfit`).val(d.treatmentProfit || 0);
                $(`#${prefix}-revenue`).val(revenue);
                $(`#${prefix}-expenses`).val(d.expenses               || 0);
                $(`#${prefix}-savings`).val(d.savings                 || 0);
                $(`#${prefix}-remaining`).val(revenue - (d.expenses||0));
            })
            .fail(() => addFlashMessage('Lỗi kết nối khi tải dữ liệu báo cáo.', FLASH_MESSAGE_TYPE_ERROR))
            .always(() => $(`#${prefix}-loadingMsg`).addClass('d-none'));
    }

    function resetFinanceFields(prefix) {
        ['petShopRevenue','petShopProfit','spaRevenue','treatmentRevenue',
         'treatmentProfit','revenue','expenses','savings','remaining']
            .forEach(f => $(`#${prefix}-${f}`).val(''));
    }
</script>
