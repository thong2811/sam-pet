<div class="row mt-5">
    <h1> Nhập hàng hóa </h1>
    <input type="hidden" id="productList" value='<?= htmlspecialchars(json_encode($this->productList ?? [])) ?>'>
    <form method="post" action="/export-stock/do-add" id="exportStockAddForm" onchange="updateSumTotal()">
        <div class="container">
            <table class="table table-striped table-form mt-3">
                <thead>
                <tr>
                    <th style="width: 150px">Ngày</th>
                    <th style="min-width: 300px">Tên hàng hóa</th>
                    <th style="width: 150px">Giá nhập</th>
                    <th style="width: 150px">Giá bán</th>
                    <th style="width: 80px">Số lượng</th>
                    <th style="width: 400px">Ghi chú</th>
                    <th style="width: 60px">Xóa</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>
                        <input class="form-control date-picker w-100" name="date[]" value="<?= date('d-m-Y') ?>" autocomplete="off" required/>
                    </td>
                    <td>
                        <select class="select-product form-control select2" name="productId[]" onchange="updateRowData(this)">
                            <option value="">Chọn hàng hóa</option>
                            <?php foreach ($this->productList as $id => $product): ?>
                            <option value="<?= $id ?>"><?= $product['name'] ?? '' ?></option>
                            <?php endforeach; ?>
                        </select>
                    </td>
                    <td>
                        <div class="input-group">
                            <input type="text" class="form-control" id="purchasePrice" name="purchasePrice[]" value="0" required>
                        </div>
                    </td>
                    <td>
                        <div class="input-group">
                            <input type="text" class="form-control selling-price" id="sellingPrice" name="sellingPrice[]" value="0" required>
                        </div>
                    </td>
                    <td>
                        <input class="form-control quantity" type="number" name="quantity[]" value="1" required>
                    </td>
                    <td>
                        <textarea class="form-control" name="note[]" rows="1"></textarea>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeInputRow(this)">✕</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="mb-3">
            <div class="mb-3 bottom-sticky">
                <div class="alert alert-info">Tổng cộng:
                    <span class="fw-bold" id="sumTotal"></span>
                </div>
            <button type="button" class="btn btn-primary float-end" onclick="doSubmit()">Tạo</button>
            <a href="/export-stock" class="btn btn-secondary float-end mx-2">Quay lại</a>
        </div>
    </form>
</div>

<script>
    let tableInputRowHtml = ``;
    let productList = [];
    $(document).ready(function() {
        tableInputRowHtml = `<tr>${$('.table-form').find('tbody tr').last().html()}</tr>`;
        updateSumTotal();

        initVariable();
        $('.select2').select2({
            dropdownCssClass: 'select-product-custom'
        });
        $('.date-picker').datepicker({
            format: 'dd-mm-yyyy',
            autoclose:true
        });
    });

    $(document).keypress(event => {
        if (event.which == '13') {
            event.preventDefault();
        }
    });

    function initVariable() {
        let data = $('#productList').val();
        productList = JSON.parse(data);
    }

    function updateRowData(elm) {
        let value = $(elm).val();
        const tbodyElm = $(elm).closest('tbody');
        const trElm = $(elm).closest('tr');

        const productData = productList[value] ?? {};

        trElm.find('#purchasePrice').val(productData.purchasePrice || 0);
        trElm.find('#sellingPrice').val(productData.sellingPrice || 0);

        if (value) {
            if ($('.select-product').last().val() !== '') {
                addInputRow(tbodyElm);
            }
        }
    }

    function addInputRow(tbodyElm) {
        const date = tbodyElm.find('.date-picker').last().val();

        tbodyElm.append(tableInputRowHtml);
        tbodyElm.find('.select2').select2({
            dropdownCssClass: 'select-product-custom'
        });
        const datePicker = tbodyElm.find('.date-picker').last();
        datePicker.val();
        datePicker.datepicker({
            format: 'dd-mm-yyyy',
            autoclose:true
        });
        datePicker.val(date);
    }

    function removeInputRow(btn) {
        const tbody = $(btn).closest('tbody');
        // Không cho xóa nếu chỉ còn 1 dòng
        if (tbody.find('tr').length <= 1) return;
        $(btn).closest('tr').remove();
        updateSumTotal();
    }

    function updateSumTotal() {
        let sumTotal = 0;
        try {
            let sellingPriceInputList = $('.selling-price');
            let quantityInputList = $('.quantity');

            sellingPriceInputList.each((index) => {
                    const sellingPrice = sellingPriceInputList.eq(index).val();
                    const quantity = quantityInputList.eq(index).val();
                    sumTotal = sumTotal + sellingPrice * quantity;
            })

            sumTotal = sumTotal.toLocaleString() + ' VNĐ';
        } catch (e) {
            sumTotal = 'ERROR';
            console.log("Không thể tính tổng giá trị xuất hàng : ", e);
        }

        $('#sumTotal').html(sumTotal);

    }
</script>

<script id="export-stock-add-ajax">
    function doSubmit() {
        showOverlay('loading');
        $.ajax({
            url: '/export-stock/do-add',
            type: 'POST',
            data: $('#exportStockAddForm').serialize(),
            success: function (res) {
                if (res.success) {
                    addFlashMessage(res.message || 'Thêm thành công!');
                    window.location.href = '/export-stock';
                } else {
                    addFlashMessage(res.message || 'Có lỗi xảy ra.', FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, err) {
                addFlashMessage('Lỗi kết nối: ' + err, FLASH_MESSAGE_TYPE_ERROR);
            },
            complete: hideOverlay
        });
    }
</script>
