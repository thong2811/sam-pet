            <tbody>
            <?php
            $i = 1;
            foreach ($this->productList as $id => $product):
                $stocktakingData = $this->stocktakingList[$id] ?? [];
                $stocktaking = $stocktakingData["stocktaking"] ?? "";
                $isNotEq = $stocktaking !== "" && $product['remainStock'] !== (int) $stocktaking;
                ?>
                <tr class="stocktaking-row" style="background: <?= $isNotEq ? "red" : "white" ?>">
                    <td><?= $i ?></td>
                    <td><?= $product['name'] ?? "NO NAME" ?></td>
                    <td><?= $product['initStock'] ?? "Không có" ?></td>
                    <td><?= $product['importStock'] ?? "Không có" ?></td>
                    <td><?= $product['exportStock'] ?? "Không có" ?></td>
                    <td><?= $product['repackageStock'] ?? "Không có" ?></td>
