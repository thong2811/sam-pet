<!-- ── Stocktaking Modal ─────────────────────────────────────────── -->
<div class="modal fade" id="renewWarehouseModal" tabindex="-1" aria-labelledby="renewWarehouseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="renewWarehouseModalLabel">🔒 Xác nhận chốt kho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Cảnh báo sản phẩm chưa nhập -->
                <div id="missingStocktakingAlert" class="alert alert-warning d-none">
                    <strong>⚠ Các sản phẩm chưa nhập số kiểm kê:</strong>
                    <ul id="missingList" class="mb-0 mt-1"></ul>
                </div>

                <p class="mb-2">Sau khi chốt kho:</p>
                <ul>
                    <li>Dữ liệu nhập / xuất hàng sẽ được xóa</li>
                    <li>Tồn kho sẽ được set lại theo số kiểm kê thực tế</li>
                    <li>Lịch sử kỳ kiểm kê sẽ được lưu lại để đối soát</li>
                </ul>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ghi chú kỳ kiểm kê:</label>
                    <input type="text" id="renewNote" class="form-control" placeholder="Ví dụ: Kiểm kê tháng 9/2026"/>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirmRenewCheck"
                           onchange="$('#btnRenewWarehouse').prop('disabled', !this.checked)">
                    <label class="form-check-label text-danger fw-bold" for="confirmRenewCheck">
                        Tôi hiểu và xác nhận chốt kho
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnRenewWarehouse"
                        disabled onclick="submitRenewWarehouse()">
                    🔒 Chốt kho
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const renewModal = new bootstrap.Modal('#renewWarehouseModal', {});

    function openRenewWarehouseModal() {
        // Tìm sản phẩm chưa nhập số kiểm kê
        const missing = [];
        document.querySelectorAll('.stocktaking-input').forEach(function (input) {
            if (input.value === '' || input.value === null) {
                const row  = input.closest('tr');
                const name = row ? row.cells[1].textContent.trim() : input.dataset.productId;
                missing.push(name);
            }
        });

        if (missing.length > 0) {
            const list = document.getElementById('missingList');
            list.innerHTML = missing.map(n => `<li>${n}</li>`).join('');
            document.getElementById('missingStocktakingAlert').classList.remove('d-none');
        } else {
            document.getElementById('missingStocktakingAlert').classList.add('d-none');
        }

        // Reset checkbox và nút
        document.getElementById('confirmRenewCheck').checked = false;
        document.getElementById('btnRenewWarehouse').disabled = true;
        document.getElementById('renewNote').value = '';

        renewModal.show();
    }

    function submitRenewWarehouse() {
        const note = document.getElementById('renewNote').value.trim();

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/stocktaking/renew-warehouse';

        const fields = {
            '_csrf':    getCsrfToken(),
            'closedAt': getCurrentDateVn(),
            'note':     note,
        };

        Object.entries(fields).forEach(([name, value]) => {
            const input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = name;
            input.value = value;
            form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
    }

    function getCurrentDateVn() {
        const d = new Date();
        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();
        return `${dd}-${mm}-${yyyy}`;
    }
</script>
