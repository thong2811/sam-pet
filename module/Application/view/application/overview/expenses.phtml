        </div>
    </div>

    <!-- Charts -->
    <div id="dailyChart" class="chart mb-4"></div>
    <div id="monthlyChart" class="chart"></div>
</div>

<script>
    const rawData = <?= json_encode($this->data, JSON_UNESCAPED_UNICODE) ?>;

    $(function () {
        fillSummaryCards();
        renderExpensesChart('dailyChart', false);
        renderExpensesChart('monthlyChart', true);
    });

    function fillSummaryCards() {
        const fmt = v => formatNumber(v) + ' VNĐ';
        let totalRevenue = 0, totalExpenses = 0, totalSavings = 0, totalRemaining = 0;
        (rawData.revenue   || []).forEach(p => totalRevenue   += p[1]);
        (rawData.expenses  || []).forEach(p => totalExpenses  += p[1]);
        (rawData.savings   || []).forEach(p => totalSavings   += p[1]);
        (rawData.remaining || []).forEach(p => totalRemaining += p[1]);

        $('#cardTotalRevenue').text(fmt(totalRevenue));
        $('#cardTotalExpenses').text(fmt(totalExpenses));
        $('#cardTotalSavings').text(fmt(totalSavings));

        const remainingEl = $('#cardTotalRemaining');
        remainingEl.text(fmt(totalRemaining));
        remainingEl.removeClass('text-info text-danger text-success');
        remainingEl.addClass(totalRemaining >= 0 ? 'text-success' : 'text-danger');
    }

    function aggregateByMonth(points) {
        const map = {};
        (points || []).forEach(([ts, val]) => {
            const d   = new Date(ts);
            const key = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1);
            map[key]  = (map[key] || 0) + val;
        });
        return Object.entries(map)
            .map(([k, v]) => [Number(k), v])
            .sort((a, b) => a[0] - b[0]);
    }

    function renderExpensesChart(containerId, isMonthly) {
        const title      = isMonthly ? 'Thu / Chi theo tháng' : 'Thu / Chi theo ngày';
        const dateFormat = isMonthly ? '%m/%Y' : '%d/%m/%Y';

        const makeSeries = (name, key, color, dashStyle = 'Solid') => ({
            name,
            color,
            dashStyle,
            data: isMonthly ? aggregateByMonth(rawData[key]) : (rawData[key] || []),
        });

        Highcharts.chart(containerId, {
            chart: { type: 'line', zoomType: 'x' },
            title: { text: title },
            xAxis: {
                type: 'datetime',
                labels: { format: `{value:${dateFormat}}` },
            },
            yAxis: {
                title: { text: 'VNĐ' },
                labels: {
                    formatter: function () {
                        return Highcharts.numberFormat(this.value, 0, '.', ',');
                    }
                },
                plotLines: [{
                    value: 0,
                    color: '#aaa',
                    width: 1,
                    dashStyle: 'Dot',
                }]
            },
            tooltip: {
                shared: true,
                xDateFormat: dateFormat,
                formatter: function () {
                    let s = `<b>${Highcharts.dateFormat(dateFormat, this.x)}</b><br/>`;
                    this.points.forEach(p => {
                        s += `<span style="color:${p.color}">●</span> ${p.series.name}: <b>${Highcharts.numberFormat(p.y, 0, '.', ',')} VNĐ</b><br/>`;
                    });
                    return s;
                }
            },
            legend: { enabled: true },
            series: [
                makeSeries('Doanh thu',     'revenue',   '#2ecc71'),
                makeSeries('Chi phí',       'expenses',  '#e74c3c'),
                makeSeries('Tiết kiệm',     'savings',   '#95a5a6', 'ShortDash'),
                makeSeries('Còn lại',       'remaining', '#3498db', 'ShortDot'),
            ],
            exporting: { enabled: true },
        });
    }
</script>
