<div class="container mt-4">

    <!-- Tab -->
    <div class="mb-3">
        <a class="btn btn-outline-primary" href="/overview">📈 Doanh thu</a>
        <a class="btn btn-primary active ms-2" href="/overview/expenses">💰 Thu / Chi</a>
    </div>

    <!-- Date range -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="text-muted small">Khoảng thời gian:</span>
        <input type="text" id="chartFrom" class="form-control date-picker" placeholder="Từ ngày" autocomplete="off" style="width:130px"/>
        <span class="text-muted">—</span>
        <input type="text" id="chartTo"   class="form-control date-picker" placeholder="Đến ngày" autocomplete="off" style="width:130px"/>
        <button class="btn btn-primary btn-sm" onclick="loadChart()">Xem</button>
        <button class="btn btn-outline-secondary btn-sm" onclick="clearFilter()">✕ Tất cả</button>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-success h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">Tổng doanh thu</div>
                    <div class="fw-bold fs-5 text-success" id="cardTotalRevenue">—</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-danger h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">Tổng chi phí</div>
                    <div class="fw-bold fs-5 text-danger" id="cardTotalExpenses">—</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-secondary h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">Tiết kiệm</div>
                    <div class="fw-bold fs-5 text-secondary" id="cardTotalSavings">—</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-info h-100">
                <div class="card-body p-3">
                    <div class="text-muted small">Còn lại (thu - chi)</div>
                    <div class="fw-bold fs-5 text-info" id="cardTotalRemaining">—</div>
                </div>
            </div>
        </div>
    </div>

    <div id="chartLoading" class="text-center text-muted py-4 d-none">
        <div class="spinner-border spinner-border-sm me-2"></div>Đang tải biểu đồ...
    </div>
    <div id="dailyChart"   class="chart mb-4"></div>
    <div id="monthlyChart" class="chart"></div>
</div>

<script>
    let rawData = {};

    $(function () { loadChart(); });

    function clearFilter() {
        $('#chartFrom').val('').datepicker('clearDates');
        $('#chartTo').val('').datepicker('clearDates');
        loadChart();
    }

    function loadChart() {
        const from = $('#chartFrom').val() || '';
        const to   = $('#chartTo').val()   || '';

        $('#chartLoading').removeClass('d-none');
        $('#dailyChart, #monthlyChart').empty();

        $.get('/overview/chart-data', { from, to })
            .done(function (res) {
                $('#chartLoading').addClass('d-none');
                if (!res.success) {
                    addFlashMessage('Lỗi tải biểu đồ: ' + res.message, FLASH_MESSAGE_TYPE_ERROR);
                    return;
                }
                rawData = res.data || {};
                fillSummaryCards(res.totals || {});
                renderExpensesChart('dailyChart',   false);
                renderExpensesChart('monthlyChart', true);
            })
            .fail(function () {
                $('#chartLoading').addClass('d-none');
                addFlashMessage('Không thể tải dữ liệu biểu đồ.', FLASH_MESSAGE_TYPE_ERROR);
            });
    }

    function fillSummaryCards(totals) {
        const fmt = v => formatNumber(Math.round(v)) + ' VNĐ';
        const remaining = totals.totalRemaining || 0;
        $('#cardTotalRevenue').text(fmt(totals.totalRevenue   || 0));
        $('#cardTotalExpenses').text(fmt(totals.totalExpenses || 0));
        $('#cardTotalSavings').text(fmt(
            (rawData.savings || []).reduce((s, p) => s + p[1], 0)
        ));
        const $rem = $('#cardTotalRemaining');
        $rem.text(fmt(remaining));
        $rem.removeClass('text-info text-danger text-success')
            .addClass(remaining >= 0 ? 'text-success' : 'text-danger');
    }

    function aggregateByMonth(points) {
        const map = {};
        (points || []).forEach(([ts, val]) => {
            const d   = new Date(ts);
            const key = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1);
            map[key]  = (map[key] || 0) + val;
        });
        return Object.entries(map).map(([k, v]) => [Number(k), v]).sort((a, b) => a[0] - b[0]);
    }

    function renderExpensesChart(containerId, isMonthly) {
        const title      = isMonthly ? 'Thu / Chi theo tháng' : 'Thu / Chi theo ngày';
        const dateFormat = isMonthly ? '%m/%Y' : '%d/%m/%Y';
        const makeSeries = (name, key, color, dashStyle = 'Solid') => ({
            name, color, dashStyle,
            data: isMonthly ? aggregateByMonth(rawData[key]) : (rawData[key] || []),
        });
        Highcharts.chart(containerId, {
            chart: { type: 'line', zoomType: 'x' },
            title: { text: title },
            xAxis: { type: 'datetime', labels: { format: `{value:${dateFormat}}` } },
            yAxis: {
                title: { text: 'VNĐ' },
                labels: { formatter: function () { return Highcharts.numberFormat(this.value, 0, '.', ','); } },
                plotLines: [{ value: 0, color: '#aaa', width: 1, dashStyle: 'Dot' }]
            },
            tooltip: {
                shared: true, xDateFormat: dateFormat,
                formatter: function () {
                    let s = `<b>${Highcharts.dateFormat(dateFormat, this.x)}</b><br/>`;
                    this.points.forEach(p => {
                        s += `<span style="color:${p.color}">●</span> ${p.series.name}: <b>${Highcharts.numberFormat(p.y, 0, '.', ',')} VNĐ</b><br/>`;
                    });
                    return s;
                }
            },
            legend: { enabled: true },
            series: [
                makeSeries('Doanh thu', 'revenue',   '#2ecc71'),
                makeSeries('Chi phí',   'expenses',  '#e74c3c'),
                makeSeries('Tiết kiệm', 'savings',   '#95a5a6', 'ShortDash'),
                makeSeries('Còn lại',   'remaining', '#3498db', 'ShortDot'),
            ],
            exporting: { enabled: true },
        });
    }
</script>
