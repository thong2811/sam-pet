                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div id="dailyChart" class="chart mb-4"></div>
    <div id="monthlyChart" class="chart"></div>
</div>

<script>
    const rawData = <?= json_encode($this->data, JSON_UNESCAPED_UNICODE) ?>;
    const totals  = <?= json_encode($totals, JSON_UNESCAPED_UNICODE) ?>;

    $(function () {
        fillSummaryCards();
        renderRevenueChart('dailyChart', false);
        renderRevenueChart('monthlyChart', true);
    });

    function fillSummaryCards() {
        const fmt = v => formatNumber(v) + ' VNĐ';
        // Tính từ rawData để đảm bảo nhất quán với chart
        let totalRevenue = 0, totalProfit = 0, totalTreatment = 0, totalSpa = 0;
        (rawData.revenue        || []).forEach(p => totalRevenue   += p[1]);
        (rawData.petShopProfit  || []).forEach(p => totalProfit    += p[1]);
        (rawData.treatmentRevenue || []).forEach(p => totalTreatment += p[1]);
        (rawData.spaRevenue     || []).forEach(p => totalSpa       += p[1]);

        $('#cardTotalRevenue').text(fmt(totalRevenue));
        $('#cardTotalProfit').text(fmt(totalProfit));
        $('#cardTreatmentRevenue').text(fmt(totalTreatment));
        $('#cardSpaRevenue').text(fmt(totalSpa));
    }

    // Aggregate data gốc (array [[timestamp, value]]) theo tháng
    function aggregateByMonth(points) {
        const map = {};
        (points || []).forEach(([ts, val]) => {
            const d   = new Date(ts);
            const key = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1);
            map[key]  = (map[key] || 0) + val;
        });
        return Object.entries(map)
            .map(([k, v]) => [Number(k), v])
            .sort((a, b) => a[0] - b[0]);
    }

    function renderRevenueChart(containerId, isMonthly) {
        const title      = isMonthly ? 'Doanh thu theo tháng' : 'Doanh thu theo ngày';
        const dateFormat = isMonthly ? '%m/%Y' : '%d/%m/%Y';

        const makeSeries = (name, key, color) => ({
            name,
            color,
            data: isMonthly ? aggregateByMonth(rawData[key]) : (rawData[key] || []),
        });

        Highcharts.chart(containerId, {
            chart: { type: 'line', zoomType: 'x' },
            title: { text: title },
            xAxis: {
                type: 'datetime',
                labels: { format: `{value:${dateFormat}}` },
            },
            yAxis: {
                title: { text: 'VNĐ' },
                labels: {
                    formatter: function () {
                        return Highcharts.numberFormat(this.value, 0, '.', ',');
                    }
                }
            },
            tooltip: {
                shared: true,
                xDateFormat: dateFormat,
                valueDecimals: 0,
                valuePrefix: '',
                valueSuffix: ' VNĐ',
                formatter: function () {
                    let s = `<b>${Highcharts.dateFormat(dateFormat, this.x)}</b><br/>`;
                    this.points.forEach(p => {
                        s += `<span style="color:${p.color}">●</span> ${p.series.name}: <b>${Highcharts.numberFormat(p.y, 0, '.', ',')} VNĐ</b><br/>`;
                    });
                    return s;
                }
            },
            legend: { enabled: true },
            series: [
                makeSeries('Tổng doanh thu',    'revenue',          '#2ecc71'),
                makeSeries('Doanh thu pet shop', 'petShopRevenue',   '#3498db'),
                makeSeries('Lãi pet shop',       'petShopProfit',    '#1abc9c'),
                makeSeries('Thu spa',            'spaRevenue',       '#e67e22'),
                makeSeries('Thu điều trị',       'treatmentRevenue', '#9b59b6'),
            ],
            exporting: { enabled: true },
        });
    }
</script>
