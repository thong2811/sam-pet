<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */
?>
<div class="container mt-5">
    <h1 class="mb-5">Lịch sử khám bệnh</h1>
    <div class="my-2">
        <a href="/medical-record/add" class="btn btn-primary">Thêm lần khám +</a>
    </div>
    <table id="dataTable" class="table table-striped" style="width:100%">
        <thead>
        <tr>
            <th>STT</th>
            <th>Thú</th>
            <th>Chủ</th>
            <th>Ngày khám</th>
            <th>Triệu chứng</th>
            <th>Chẩn đoán</th>
            <th>Toa thuốc</th>
            <th>Thao tác</th>
        </tr>
        </thead>
    </table>
</div>
<script>
    const table = initDataTable('#dataTable', {
        ...DATA_TABLES_CONFIG,
        ajax: {
            url: '/medical-record/data-table-server-side',
            type: 'POST'
        },
        columns: [
            { name: 'no', data: 'no' },
            { name: 'pet_name', data: 'pet_name' },
            { name: 'owner_name', data: 'owner_name' },
            { name: 'visit_date', data: 'visit_date' },
            { name: 'symptoms', data: 'symptoms' },
            { name: 'diagnosis', data: 'diagnosis' },
            { name: 'prescription', data: 'prescription' },
            { name: 'action', data: 'action' }
        ],
        serverSide: true
    });

    function remove(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa?')) return;
        $.ajax({
            url: '/medical-record/do-delete',
            type: 'DELETE',
            contentType: 'application/json',
            data: JSON.stringify({ id: id }),
            success: function (response) {
                if (response.success) {
                    table.draw(false);
                    addFlashMessage('Xoá thành công');
                } else {
                    addFlashMessage('Lỗi: ' + (response.message || ''), FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, error) {
                addFlashMessage('Lỗi: ' + error, FLASH_MESSAGE_TYPE_ERROR);
            }
        });
    }
</script>
