<div class="container mt-4">
    <h1 class="mb-3">Lịch sử khám bệnh</h1>

    <div class="my-2">
        <a href="/medical-record/add" class="btn btn-primary">+ Thêm lần khám</a>
    </div>
    <table id="dataTable" class="table table-striped" style="width:100%">
        <thead>
        <tr>
            <th>STT</th>
            <th>Thú</th>
            <th>Chủ</th>
            <th>Ngày khám</th>
            <th>Triệu chứng</th>
            <th>Chẩn đoán</th>
            <th>Toa thuốc</th>
            <th>Thao tác</th>
        </tr>
        </thead>
    </table>
</div>
<script>
    const table = initDataTable('#dataTable', {
        ...DATA_TABLES_CONFIG,
        ajax: {
            url: '/medical-record/data-table-server-side',
            type: 'POST'
        },
        columns: [
            { name: 'no', data: 'no' },
            { name: 'pet_name', data: 'pet_name' },
            { name: 'owner_name', data: 'owner_name' },
            { name: 'visit_date', data: 'visit_date' },
            { name: 'symptoms', data: 'symptoms' },
            { name: 'diagnosis', data: 'diagnosis' },
            { name: 'prescription', data: 'prescription' },
            {
                name: 'action', data: 'id',
                render: (id) =>
                    `<a class="btn btn-primary btn-sm" href="/medical-record/edit/${id}">Sửa</a>` +
                    `<button class="btn btn-danger btn-sm ms-1" onclick="removeRow('medical-record','${id}',table)">Xóa</button>`
            }
        ],
        serverSide: true
    });

    function remove(id) { removeRow('medical-record', id, table); }
</script>
