<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */
?>
<div class="row mt-5">
    <h1> Chỉnh sửa nhập hàng ngày <?= $this->escapeHtml($this->date) ?></h1>
    <input type="hidden" id="productList" value='<?= htmlspecialchars(json_encode($this->productList ?? [])) ?>'>
    <form id="importStockEditForm">
        <div class="container">
            <table class="table table-striped table-form mt-3">
                <thead>
                <tr>
                    <th style="width: 150px">Ngày</th>
                    <th style="min-width: 300px">Tên hàng hóa</th>
                    <th style="width: 150px">Giá nhập</th>
                    <th style="width: 80px">Số lượng</th>
                    <th style="width: 400px">Ghi chú</th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($this->importStockList as $importStockId => $importStockData):
                    $rowDate       = $importStockData['date']          ?? '';
                    $quantity      = $importStockData['quantity']       ?? 0;
                    $purchasePrice = $importStockData['purchasePrice']  ?? 0;
                    $note          = $importStockData['note']           ?? '';
                ?>
                <tr>
                    <input type="hidden" name="importStockId[]" value="<?= $importStockId ?>">
                    <td>
                        <input class="form-control date-picker w-100" name="date[]"
                               value="<?= $this->escapeHtmlAttr($rowDate) ?>" autocomplete="off" required/>
                    </td>
                    <td>
                        <select class="select-product form-control select2" name="productId[]"
                                onchange="updateRowData(this)" required>
                            <option value="">Chọn hàng hóa</option>
                            <?php foreach ($this->productList as $productId => $productData):
                                $isSelected  = !empty($importStockData['productId']) && $importStockData['productId'] == $productId;
                            ?>
                                <option value="<?= $productId ?>" <?= $isSelected ? 'selected' : '' ?>>
                                    <?= $productData['name'] ?? '-' ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control purchase-price" name="purchasePrice[]"
                               value="<?= $this->escapeHtmlAttr($purchasePrice) ?>" required>
                    </td>
                    <td>
                        <input class="form-control" type="number" name="quantity[]"
                               value="<?= $this->escapeHtmlAttr($quantity) ?>" min="0" required>
                    </td>
                    <td>
                        <textarea class="form-control" name="note[]" rows="1"><?= $this->escapeHtml($note) ?></textarea>
                    </td>
                </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <div class="mb-3">
            <button type="button" class="btn btn-primary float-end" onclick="doSubmit()">Lưu</button>
            <a href="/import-stock" class="btn btn-secondary float-end mx-2">Quay lại</a>
        </div>
    </form>
</div>

<script>
    let productList = {};

    $(document).ready(function () {
        productList = JSON.parse($('#productList').val() || '{}');
        $('.select2').select2({ dropdownCssClass: 'select-product-custom' });
        $('.date-picker').datepicker({ format: 'dd-mm-yyyy', autoclose: true });
    });

    $(document).keypress(e => { if (e.which === 13) e.preventDefault(); });

    function updateRowData(elm) {
        const value       = $(elm).val();
        const trElm       = $(elm).closest('tr');
        const productData = productList[value] ?? {};
        trElm.find('.purchase-price').val(productData.purchasePrice || 0);
    }

    function doSubmit() {
        const form = document.getElementById('importStockEditForm');
        if (!form.checkValidity()) { form.classList.add('was-validated'); return; }

        showOverlay('loading');

        $.ajax({
            url: '/import-stock/do-edit',
            type: 'POST',
            data: $('#importStockEditForm').serialize(),
            success: function (res) {
                if (res.success) {
                    addFlashMessage(res.message || 'Cập nhật thành công!');
                    // Controller trả redirectUrl về trang edit ngày vừa sửa
                    window.location.href = res.redirectUrl || '/import-stock';
                } else {
                    addFlashMessage(res.message || 'Có lỗi xảy ra.', FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, err) {
                addFlashMessage('Lỗi kết nối: ' + err, FLASH_MESSAGE_TYPE_ERROR);
            },
            complete: hideOverlay
        });
    }
</script>
