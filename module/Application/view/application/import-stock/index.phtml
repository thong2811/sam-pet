<div class="container mt-4">
    <h1 class="mb-3"> Nhập hàng</h1>

    <div class="my-2">
        <div class="d-flex flex-wrap gap-2 mb-2">
            <a href="/import-stock/add" class="btn btn-primary">+ Thêm mới</a>
            <div class="input-group w-auto">
                <button class="btn btn-outline-primary" onclick="editByDate()">✏ Chỉnh sửa theo ngày</button>
                <input class="form-control date-picker" id="editDate" name="date" autocomplete="off" placeholder="dd-mm-yyyy" style="width:140px"/>
            </div>
        </div>
        <?= $this->partial('partial/date-range-filter', ['prefix' => 'importStock']) ?>
    </div>
    <table id="dataTable" class="table table-striped" style="width:100%">
        <thead>
        <tr>
            <th>STT</th>
            <th>Ngày</th>
            <th>Tên hàng hóa</th>
            <th>Giá nhập</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Ghi chú</th>
            <th>Thao tác</th>
        </tr>
    </table>
</div>
<script>
    const table = initDataTable('#dataTable', {
        ...DATA_TABLES_CONFIG,
        ajax: {
            url: 'import-stock/data-table-server-side',
            type: 'POST'
        },
        columns: [
            { name: 'no', data: 'no' },
            { name: 'date', data: 'date' },
            { name: 'productName', data: 'productName' },
            { name: 'purchasePrice', data: 'purchasePrice', render: $.fn.dataTable.render.number( ',') },
            { name: 'quantity', data: 'quantity' },
            { name: 'total', data: 'total', render: $.fn.dataTable.render.number( ',') },
            { name: 'note', data: 'note' },
            {
                name: 'action', data: 'id',
                render: (id) =>
                    `<button class="btn btn-danger btn-sm" onclick="removeRow('import-stock','${id}',table)">Xóa</button>`
            }
        ],
        serverSide: true
    });

    function remove(id) { removeRow('import-stock', id, table); }

    function editByDate() {
        const date = $('#editDate').val();
        if (!date) {
            alert("Hãy nhập ngày chỉnh sửa !");
            return;
        }
        location.href = `/import-stock/edit/${date}`;
    }

    initDateRangeFilter(table, 'importStock_from', 'importStock_to');
</script>