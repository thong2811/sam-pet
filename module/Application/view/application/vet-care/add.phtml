<div class="row mt-5">
    <h1> Thêm tiền điều trị - Spa </h1>
    <form id="vetCareAddForm" class="col-md-6">
        <div class="mb-3">
            <label class="form-label">Ngày</label>
            <input type="text" class="form-control date-picker" name="date"
                   autocomplete="off" value="<?= date('d-m-Y') ?>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Tiền điều trị</label>
            <div class="input-group">
                <span class="input-group-text">VNĐ</span>
                <input type="text" class="form-control" name="treatmentAmount" required>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Tiền spa</label>
            <div class="input-group">
                <span class="input-group-text">VNĐ</span>
                <input type="text" class="form-control" name="spaAmount" required>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea class="form-control" name="note"></textarea>
        </div>
        <div class="mb-3">
            <button type="button" class="btn btn-primary float-end" onclick="doSubmit()">Tạo</button>
            <a href="/vet-care" class="btn btn-secondary float-end mx-2">Quay lại</a>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        $('.date-picker').datepicker({ format: 'dd-mm-yyyy', autoclose: true });
    });

    function doSubmit() {
        const form = document.getElementById('vetCareAddForm');
        if (!form.checkValidity()) { form.classList.add('was-validated'); return; }

        showOverlay('loading');

        $.ajax({
            url: '/vet-care/do-add',
            type: 'POST',
            data: $('#vetCareAddForm').serialize(),
            success: function (res) {
                if (res.success) {
                    addFlashMessage(res.message || 'Thêm thành công!');
                    window.location.href = '/vet-care';
                } else {
                    addFlashMessage(res.message || 'Có lỗi xảy ra.', FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, err) {
                addFlashMessage('Lỗi kết nối: ' + err, FLASH_MESSAGE_TYPE_ERROR);
            },
            complete: hideOverlay
        });
    }
</script>
