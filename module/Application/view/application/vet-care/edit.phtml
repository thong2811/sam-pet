<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */
$id              = $this->vetCareData['id']              ?? '';
$date            = $this->vetCareData['date']            ?? '';
$treatmentAmount = $this->vetCareData['treatmentAmount'] ?? 0;
$spaAmount       = $this->vetCareData['spaAmount']       ?? 0;
$note            = $this->vetCareData['note']            ?? '';
?>
<div class="row mt-5">
    <h1> Chỉnh sửa điều trị - Spa </h1>
    <form id="vetCareEditForm" class="col-md-6">
        <input type="hidden" name="id" value="<?= $this->escapeHtmlAttr($id) ?>">
        <div class="mb-3">
            <label class="form-label">Ngày</label>
            <input type="text" class="form-control date-picker" name="date"
                   autocomplete="off" value="<?= $this->escapeHtmlAttr($date) ?>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Tiền điều trị</label>
            <div class="input-group">
                <span class="input-group-text">VNĐ</span>
                <input type="text" class="form-control" name="treatmentAmount"
                       value="<?= $this->escapeHtmlAttr($treatmentAmount) ?>" required>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Tiền spa</label>
            <div class="input-group">
                <span class="input-group-text">VNĐ</span>
                <input type="text" class="form-control" name="spaAmount"
                       value="<?= $this->escapeHtmlAttr($spaAmount) ?>" required>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea class="form-control" name="note"><?= $this->escapeHtml($note) ?></textarea>
        </div>
        <div class="mb-3">
            <button type="button" class="btn btn-primary float-end" onclick="doSubmit()">Lưu</button>
            <a href="/vet-care" class="btn btn-secondary float-end mx-2">Quay lại</a>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        $('.date-picker').datepicker({ format: 'dd-mm-yyyy', autoclose: true });
    });

    function doSubmit() {
        const form = document.getElementById('vetCareEditForm');
        if (!form.checkValidity()) { form.classList.add('was-validated'); return; }

        showOverlay('loading');

        $.ajax({
            url: '/vet-care/do-edit',
            type: 'POST',
            data: $('#vetCareEditForm').serialize(),
            success: function (res) {
                if (res.success) {
                    addFlashMessage(res.message || 'Cập nhật thành công!');
                    window.location.href = '/vet-care';
                } else {
                    addFlashMessage(res.message || 'Có lỗi xảy ra.', FLASH_MESSAGE_TYPE_ERROR);
                }
            },
            error: function (xhr, status, err) {
                addFlashMessage('Lỗi kết nối: ' + err, FLASH_MESSAGE_TYPE_ERROR);
            },
            complete: hideOverlay
        });
    }
</script>
