<div class="container mt-4">
    <h1 class="mb-3"> Điều trị - Spa</h1>

    <div class="my-2">
        <div class="d-flex flex-wrap gap-2 mb-2">
            <a href="/vet-care/add" class="btn btn-primary">+ Thêm mới</a>
            <div class="input-group w-auto">
                <button class="btn btn-outline-primary" onclick="editByDate()">✏ Chỉnh sửa theo ngày</button>
                <input class="form-control date-picker" id="editDate" name="date" autocomplete="off" placeholder="dd-mm-yyyy" style="width:140px"/>
            </div>
        </div>
        <?= $this->partial('partial/date-range-filter', ['prefix' => 'vetCare']) ?>
    </div>
    <table id="dataTable" class="table table-striped" style="width:100%">
        <thead>
        <tr>
            <th>STT</th>
            <th>Ngày</th>
            <th>Tiền điều trị</th>
            <th>Tiền spa</th>
            <th>Tổng</th>
            <th>Ghi chú</th>
            <th>Thao tác</th>
        </tr>
        </thead>

    </table>
</div>
<script>
    const table = initDataTable('#dataTable', {
        ...DATA_TABLES_CONFIG,
        ajax: {
            url: 'vet-care/data-table-server-side',
            type: 'POST'
        },
        columns: [
            { name: 'no', data: 'no' },
            { name: 'date', data: 'date' },
            { name: 'treatmentAmount', data: 'treatmentAmount', render: $.fn.dataTable.render.number( ',') },
            { name: 'spaAmount', data: 'spaAmount', render: $.fn.dataTable.render.number( ',') },
            { name: 'total', data: 'total', render: $.fn.dataTable.render.number( ',') },
            { name: 'note', data: 'note' },
            {
                name: 'action', data: 'id',
                render: (id) =>
                    `<a href="/vet-care/edit/${id}" class="btn btn-primary btn-sm">Chỉnh sửa</a>` +
                    `<button class="btn btn-danger btn-sm ms-1" onclick="removeRow('vet-care','${id}',table)">Xóa</button>`
            }
        ],
        serverSide: true
    });

    function remove(id) { removeRow('vet-care', id, table); }

    function editByDate() {
        const date = $('#editDate').val();
        if (!date) { alert('Hãy nhập ngày chỉnh sửa!'); return; }
        table.search(date).draw();
    }

    initDateRangeFilter(table, 'vetCare_from', 'vetCare_to');
</script>